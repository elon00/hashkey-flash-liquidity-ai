{
  "mcpServers": {
    "hashkey-flash-liquidity-ai": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--quiet"
      ],
      "env": {
        "RUST_LOG": "info",
        "HACKATHON_TRACK": "HashKey Chain",
        "PROJECT_TICKER": "HKFLASH"
      },
      "tools": [
        {
          "name": "verify_hkflash_invariants",
          "description": "Verifies deterministic invariants for HashKey Flash Liquidity AI on HashKey Chain."
        },
        {
          "name": "execute_hkflash_action",
          "description": "Executes authenticated DeFi state transition."
        }
      ]
    }
  }
}